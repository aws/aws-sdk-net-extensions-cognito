<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>Amazon.Extensions.CognitoAuthentication</AssemblyName>
    <RootNamespace>Amazon.Extensions.CognitoAuthentication</RootNamespace>
    <PackageId>Amazon.Extensions.CognitoAuthentication</PackageId>
    <Product>Amazon Cognito Authentication Extension Library</Product>
    <Authors>Amazon Web Services</Authors>
    <Description>An extension library to assist in the Amazon Cognito User Pools authentication process.</Description>
    <PackageTags>AWS;Amazon;aws-sdk-v4;Cognito</PackageTags>
    <PackageProjectUrl>https://github.com/aws/aws-sdk-net-extensions-cognito/</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/aws/aws-sdk-net-extensions-cognito/</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Company>Amazon Web Services</Company>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\public.snk</AssemblyOriginatorKeyFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Deterministic>true</Deterministic>
    <!-- Enabled only on CI so local developer builds keep full absolute paths for debugging. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true' or '$(CODEBUILD_BUILD_ID)' != ''">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <Version>3.1.5</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.CognitoIdentity" Version="4.0.2.18" />
    <PackageReference Include="AWSSDK.CognitoIdentityProvider" Version="4.0.6.2" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- SourceRoot so CI packing from a .git-less archive still emits commit-pinned Source Link.
       Rooted at the repository root (two levels up from this project) so mapped document
       paths keep their src/... prefix. Guarded on SourceRevisionId so local developer builds
       are unaffected. -->
  <ItemGroup Condition="'$(SourceRevisionId)' != ''">
    <SourceRoot Include="$(MSBuildThisFileDirectory)../../"
                SourceControl="git"
                RepositoryUrl="$(RepositoryUrl)"
                RevisionId="$(SourceRevisionId)" />
  </ItemGroup>
</Project>
